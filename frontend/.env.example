# Copy to frontend/.env before running Expo.
#
# Use your computer's LAN IP + backend port (printed when Nest starts).
# Do not use localhost on a physical device — that points to the phone itself.
#
# Only EXPO_PUBLIC_* vars are bundled into the app. Never put secrets here.
# ipconfig → Wireless LAN adapter Wi‑Fi → IPv4 (e.g. 192.168.18.9). Avoid 192.168.56.1 / 172.25.x (virtual).
EXPO_PUBLIC_BACKEND_URL=http://192.168.18.9:3000
