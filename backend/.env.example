# ------------------------------------------------------------------
# DocuMind AI backend — copy to backend/.env and fill in secrets.
# Never commit backend/.env or expose these values to the mobile app.
# ------------------------------------------------------------------

# Server (0.0.0.0 = reachable from your phone on the same Wi-Fi)
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:8081

# Local JSON registry for document metadata (vectors live in ChromaDB)
DATA_DIR=./data

# OpenAI (required)
OPENAI_API_KEY=sk-proj-your-openai-key

# ChromaDB (required) — local HTTP server with persistent storage
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=documind_rag

# Retrieval / cost controls
RAG_MATCH_COUNT=4
RAG_SIMILARITY_THRESHOLD=0.72
RAG_MAX_COMPLETION_TOKENS=600
RAG_MAX_CHUNKS_PER_DOCUMENT=1500

# Normalized query cache (in-memory; cleared on index changes)
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# Rate limiting (per client IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=15